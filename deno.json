{
  "nodeModulesDir": "auto",
  "imports": {
    "pino": "npm:pino@^10.3.1",
    "pino-pretty": "npm:pino-pretty@^13.1.3",
    "@std/yaml": "jsr:@std/yaml@^1.3.0",
    "zod": "npm:zod@^4.3.6",
    "@std/expect": "jsr:@std/expect@^1.0.20",
    "@std/testing": "jsr:@std/testing@^1.0.21",
    "@std/testing/time": "jsr:@std/testing@^1.0.21/time"
  },
  "fmt": {
    "lineWidth": 100,
    "include": ["src/"]
  },
  "lint": {
    "include": ["src/"]
  },
  "tasks": {
    "dev": "deno run --allow-env --allow-read --allow-net --allow-sys --env-file=.env src/index.ts",
    "start": "deno run --allow-env --allow-read --allow-net --allow-sys --env-file=.env src/index.ts",
    "test": "deno test --allow-env --allow-read --allow-sys",
    "test:coverage": "deno test --allow-env --allow-read --allow-sys --coverage",
    "coverage:check": "deno coverage --threshold=90 coverage/",
    "type-check": "deno check src/index.ts",
    "lint": "deno lint",
    "lint:fix": "deno lint --fix",
    "format": "deno fmt",
    "format:check": "deno fmt --check",
    "check": "deno task type-check && deno task lint && deno task format:check && deno task test"
  }
}
